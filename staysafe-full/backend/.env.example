# Both keys are optional, but the link and file checks are much stronger with them.
# Google Safe Browsing: https://developers.google.com/safe-browsing/v4/get-started
GSB_API_KEY=
# VirusTotal (free account): https://www.virustotal.com/gui/my-apikey
VT_API_KEY=
# Translation — a ₹0 fallback chain: Google -> MyMemory (free) -> built-in rules.
# Google Cloud Translation (optional, best quality). Keep that Google project on the FREE TRIAL
# (never click "Upgrade") and set its "Characters per day" quota to 15000, so it can never bill you.
TRANSLATE_API_KEY=
# Extra per-day cap on Google inside this server (resets if the server restarts)
TRANSLATE_DAILY_CHAR_LIMIT=15000
# MyMemory free translator (no card, no key): 5,000 chars/day, or 50,000 with an email here
MYMEMORY_EMAIL=
