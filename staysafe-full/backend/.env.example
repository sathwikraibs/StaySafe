# Both keys are optional, but the link and file checks are much stronger with them.
# Google Safe Browsing: https://developers.google.com/safe-browsing/v4/get-started
GSB_API_KEY=
# VirusTotal (free account): https://www.virustotal.com/gui/my-apikey
VT_API_KEY=
# Google Cloud Translation (optional): lets StaySafe understand messages in any language and
# show "What this message says" in the visitor's language. Enable "Cloud Translation API" in
# Google Cloud and create a key restricted to it. If empty, GSB_API_KEY is tried instead.
TRANSLATE_API_KEY=
# Stop translating for the day after this many characters (protects the free 500,000/month tier)
TRANSLATE_DAILY_CHAR_LIMIT=15000
